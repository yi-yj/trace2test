# Alibaba Cloud Model Studio (Bailian/DashScope, China region)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TOOL_MODEL=qwen-plus
QWEN_TEMPERATURE=0

# BrowserGym / MiniWoB++
# Set this to the local frozen MiniWoB checkout. The setup command documents it.
MINIWOB_URL=file:///absolute/path/to/miniwob-plusplus/miniwob/html/miniwob/
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# Local runtime artifacts
ARTIFACT_STORE_PATH=./artifacts
