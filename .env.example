# Alibaba Cloud Model Studio (Bailian/DashScope, China region)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Model traffic bypasses the system proxy by default.
DASHSCOPE_BYPASS_PROXY=true
# Browser traffic uses BROWSER_PROXY_SERVER, then HTTPS_PROXY/HTTP_PROXY by default.
BROWSER_PROXY_ENABLED=true
BROWSER_PROXY_SERVER=
BROWSER_PROXY_BYPASS=localhost,127.0.0.1
QWEN_VISION_MODEL=qwen3-vl-plus-2025-12-19
QWEN_TOOL_MODEL=qwen-plus
QWEN_TEMPERATURE=0
QWEN_TIMEOUT_SECONDS=120

# BrowserGym / MiniWoB++
# Local frozen MiniWoB checkout. The smoke runner serves its HTML root over HTTP.
MINIWOB_ROOT=/absolute/path/to/miniwob-plusplus/miniwob/html
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# Local runtime artifacts and PostgreSQL result store
ARTIFACT_STORE_PATH=./artifacts
POSTGRES_USER=tracetotest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracetotest
DATABASE_URL=postgresql://tracetotest:change-me@localhost:5432/tracetotest
