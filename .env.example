# Alibaba Cloud Model Studio (Bailian/DashScope, China region)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TOOL_MODEL=qwen-plus
QWEN_TEMPERATURE=0

# BrowserGym / MiniWoB++
# Local frozen MiniWoB checkout. The smoke runner serves its HTML root over HTTP.
MINIWOB_ROOT=/absolute/path/to/miniwob-plusplus/miniwob/html
PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# Local runtime artifacts
ARTIFACT_STORE_PATH=./artifacts
